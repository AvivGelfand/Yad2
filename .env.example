# Copy to .env for local runs (settings.py auto-loads it via python-dotenv).
# In GitHub Actions these are provided as repo secrets instead.

# --- Google Sheets (required to write results) ---
# Path to your service-account JSON key. In CI this is written from a secret.
GOOGLE_CREDENTIALS_FILE=config/credentials.json
# The ID from your sheet URL: docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=
WORKSHEET_NAME=Properties

# --- Telegram notifications (optional; leave blank to disable) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENABLE_NOTIFICATIONS=true
NOTIFY_ON_NEW_PROPERTIES=true
NOTIFY_ON_ERROR=true

# --- Misc ---
DATABASE_PATH=data/seen_properties.json
REQUEST_DELAY=1
